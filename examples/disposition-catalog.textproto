# Safe catalog starter: entries do nothing until an administrator explicitly selects them.
# These are public Fabric manifest identities only, never artifact hashes or verdicts.
# No cheat binary, verified malicious hash, Baritone, or Freecam identity is included here.
schema_version: 1
version: "catalog-example-2026-08-09"
rollout_stage: "OBSERVE"
validity_seconds: 86400

catalog_entries {
  entry_id: "wurst-fabric-identity"
  category: CHEAT_MOD
  selector {
    artifact_type: DETECTION_ARTIFACT_MOD
    match_type: DETECTION_MATCH_MOD_ID_VERSION
    artifact_id: "wurst"
    metadata { key: "loaded" value: "true" }
  }
  confidence: DETECTION_CONFIDENCE_LOW
  suggested_action: DISPOSITION_OBSERVE
  player_message_key: "mcace.catalog.observe"
  operator_reason: "Official upstream Fabric manifest identity only; no verified artifact hash."
  false_positive_notes: "Client-reported identity is not unique evidence."
  source_id: "wurst-fabric-manifest"
  source_summary: "Official Wurst7 src/main/resources/fabric.mod.json at 64dfabaea5fa0afa4e33bc38997917c4c0c17cce, retrieved 2026-08-09; identity only, not a reviewed binary hash."
  source_uri: "https://raw.githubusercontent.com/Wurst-Imperium/Wurst7/64dfabaea5fa0afa4e33bc38997917c4c0c17cce/src/main/resources/fabric.mod.json"
  source_revision: "64dfabaea5fa0afa4e33bc38997917c4c0c17cce"
  source_manifest_path: "src/main/resources/fabric.mod.json"
  source_retrieved_at_epoch_ms: 1786204800000
  default_enabled: false
}

