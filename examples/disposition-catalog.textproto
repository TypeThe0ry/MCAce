# Explicit selection is required. Keep disabled entries without final_action.
catalog_selections { entry_id: "wurst-fabric-identity" enabled: false }
catalog_selections { entry_id: "liquidbounce-fabric-identity" enabled: false }
catalog_selections { entry_id: "meteor-client-fabric-identity" enabled: false }

# Manual exact-player ALLOW exception remains available for reviewed event use.
rules {
  rule {
    rule_id: "allow-reviewed-event-staff"
    priority: 1000
    revision: 1
    selector {
      artifact_type: DETECTION_ARTIFACT_MOD
      match_type: DETECTION_MATCH_MOD_ID_VERSION
      artifact_id: "approved-event-tool"
      version_constraint: "1.0.0"
    }
    scope { player_ids: "00000000-0000-0000-0000-000000000001" }
    confidence: DETECTION_CONFIDENCE_HIGH
    default_action: DISPOSITION_ALLOW
    exception: true
    operator_reason: "Reviewed, time-bounded player exception."
  }
}
